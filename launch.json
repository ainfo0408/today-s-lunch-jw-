    "configurations": [
        {
            "name": "1. 파이썬 백엔드 실행",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "2. 크롬 브라우저 접속",
            "url": "http://localhost:5000",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "🚀 급식 앱 한 번에 실행하기",
            "configurations": [
                "1. 파이썬 백엔드 실행",
                "2. 크롬 브라우저 접속"
            ],
            "stopAll": true
        }
    ]
}